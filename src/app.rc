#include <windows.h>
#pragma code_page(65001)

APPICON ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,8,0,0
 PRODUCTVERSION 1,8,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "fogevmi"
            VALUE "FileDescription", "Sharkonv — конвертер книг: FB2, EPUB, MOBI, PDF, DjVu, DOC, DOCX, ODT, RTF, TXT, HTML"
            VALUE "FileVersion", "1.8.0.0"
            VALUE "InternalName", "sharkonv"
            VALUE "OriginalFilename", "sharkonv.exe"
            VALUE "ProductName", "Sharkonv"
            VALUE "ProductVersion", "1.8.0.0"
            VALUE "LegalCopyright", "Свободное использование"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
